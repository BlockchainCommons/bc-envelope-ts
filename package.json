{
  "name": "@blockchaincommons/envelope",
  "version": "1.0.0-beta.1",
  "type": "module",
  "sideEffects": [
    "./dist/all.mjs",
    "./dist/all.cjs",
    "./dist/format.mjs",
    "./dist/format.cjs"
  ],
  "description": "Gordian Envelope for TypeScript",
  "license": "BSD-2-Clause-Patent",
  "homepage": "https://github.com/BlockchainCommons/bc-envelope-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockchainCommons/bc-envelope-ts.git"
  },
  "bugs": {
    "url": "https://github.com/BlockchainCommons/bc-envelope-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.mts",
        "default": "./dist/all.mjs"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      },
      "default": "./dist/all.mjs"
    },
    "./format": {
      "import": {
        "types": "./dist/format.d.mts",
        "default": "./dist/format.mjs"
      },
      "require": {
        "types": "./dist/format.d.cts",
        "default": "./dist/format.cjs"
      },
      "default": "./dist/format.mjs"
    },
    "./expression": {
      "import": {
        "types": "./dist/expression.d.mts",
        "default": "./dist/expression.mjs"
      },
      "require": {
        "types": "./dist/expression.d.cts",
        "default": "./dist/expression.cjs"
      },
      "default": "./dist/expression.mjs"
    },
    "./attachment": {
      "import": {
        "types": "./dist/attachment.d.mts",
        "default": "./dist/attachment.mjs"
      },
      "require": {
        "types": "./dist/attachment.d.cts",
        "default": "./dist/attachment.cjs"
      },
      "default": "./dist/attachment.mjs"
    },
    "./edge": {
      "import": {
        "types": "./dist/edge.d.mts",
        "default": "./dist/edge.mjs"
      },
      "require": {
        "types": "./dist/edge.d.cts",
        "default": "./dist/edge.cjs"
      },
      "default": "./dist/edge.mjs"
    },
    "./proof": {
      "import": {
        "types": "./dist/proof.d.mts",
        "default": "./dist/proof.mjs"
      },
      "require": {
        "types": "./dist/proof.d.cts",
        "default": "./dist/proof.cjs"
      },
      "default": "./dist/proof.mjs"
    },
    "./recipient": {
      "import": {
        "types": "./dist/recipient.d.mts",
        "default": "./dist/recipient.mjs"
      },
      "require": {
        "types": "./dist/recipient.d.cts",
        "default": "./dist/recipient.cjs"
      },
      "default": "./dist/recipient.mjs"
    },
    "./salt": {
      "import": {
        "types": "./dist/salt.d.mts",
        "default": "./dist/salt.mjs"
      },
      "require": {
        "types": "./dist/salt.d.cts",
        "default": "./dist/salt.cjs"
      },
      "default": "./dist/salt.mjs"
    },
    "./secret": {
      "import": {
        "types": "./dist/secret.d.mts",
        "default": "./dist/secret.mjs"
      },
      "require": {
        "types": "./dist/secret.d.cts",
        "default": "./dist/secret.cjs"
      },
      "default": "./dist/secret.mjs"
    },
    "./signature": {
      "import": {
        "types": "./dist/signature.d.mts",
        "default": "./dist/signature.mjs"
      },
      "require": {
        "types": "./dist/signature.d.cts",
        "default": "./dist/signature.cjs"
      },
      "default": "./dist/signature.mjs"
    },
    "./sskr": {
      "import": {
        "types": "./dist/sskr.d.mts",
        "default": "./dist/sskr.mjs"
      },
      "require": {
        "types": "./dist/sskr.d.cts",
        "default": "./dist/sskr.cjs"
      },
      "default": "./dist/sskr.mjs"
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      },
      "default": "./dist/types.mjs"
    },
    "./seal": {
      "import": {
        "types": "./dist/seal.d.mts",
        "default": "./dist/seal.mjs"
      },
      "require": {
        "types": "./dist/seal.d.cts",
        "default": "./dist/seal.cjs"
      },
      "default": "./dist/seal.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "api:snapshot": "bun scripts/api-snapshot.mjs && node scripts/api-report.mjs --local",
    "api:check": "bun scripts/api-snapshot.mjs --check && node scripts/api-report.mjs",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "postinstall": "node scripts/pin-lint-typescript.mjs",
    "prepublishOnly": "npm run build",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "check:deps": "node scripts/check-deps.mjs",
    "test:golden": "vitest run tests/golden-vectors.test.ts",
    "test:differential": "vitest run tests/differential.test.ts",
    "vectors:generate": "bun scripts/generate-vectors.mjs",
    "baseline:build": "bun scripts/build-baseline.mjs"
  },
  "keywords": [
    "envelope",
    "cbor",
    "dcbor",
    "gordian",
    "blockchain-commons",
    "privacy",
    "encryption",
    "deterministic",
    "encoding",
    "serialization"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.1.1",
    "@types/pako": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "prettier": "3.9.6",
    "publint": "^0.3.21",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.8",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@blockchaincommons/components": "^1.0.0-beta.1",
    "@blockchaincommons/crypto": "^1.0.0-beta.1",
    "@blockchaincommons/dcbor-compat": "^1.0.0-beta.1",
    "@blockchaincommons/known-values": "^1.0.0-beta.1",
    "@blockchaincommons/rand": "^1.0.0-beta.1",
    "@blockchaincommons/sskr": "^1.0.0-beta.1",
    "@blockchaincommons/tags": "^1.0.0-beta.1",
    "@blockchaincommons/uniform-resources": "^1.0.0-beta.1",
    "pako": "^3.0.1"
  }
}
