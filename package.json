{
  "name": "@blockchaincommons/envelope",
  "version": "1.0.0-beta.3",
  "type": "module",
  "sideEffects": [
    "./dist/all.mjs",
    "./dist/all.cjs",
    "./dist/format.mjs",
    "./dist/format.cjs"
  ],
  "description": "Gordian Envelope for TypeScript",
  "license": "BSD-2-Clause-Patent",
  "author": {
    "name": "Blockchain Commons",
    "email": "info@blockchaincommons.com",
    "url": "https://www.blockchaincommons.com"
  },
  "homepage": "https://github.com/BlockchainCommons/bc-envelope-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockchainCommons/bc-envelope-ts.git"
  },
  "bugs": {
    "url": "https://github.com/BlockchainCommons/bc-envelope-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.mts",
        "default": "./dist/all.mjs"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      },
      "default": "./dist/all.mjs"
    },
    "./format": {
      "import": {
        "types": "./dist/format.d.mts",
        "default": "./dist/format.mjs"
      },
      "require": {
        "types": "./dist/format.d.cts",
        "default": "./dist/format.cjs"
      },
      "default": "./dist/format.mjs"
    },
    "./expression": {
      "import": {
        "types": "./dist/expression.d.mts",
        "default": "./dist/expression.mjs"
      },
      "require": {
        "types": "./dist/expression.d.cts",
        "default": "./dist/expression.cjs"
      },
      "default": "./dist/expression.mjs"
    },
    "./attachment": {
      "import": {
        "types": "./dist/attachment.d.mts",
        "default": "./dist/attachment.mjs"
      },
      "require": {
        "types": "./dist/attachment.d.cts",
        "default": "./dist/attachment.cjs"
      },
      "default": "./dist/attachment.mjs"
    },
    "./edge": {
      "import": {
        "types": "./dist/edge.d.mts",
        "default": "./dist/edge.mjs"
      },
      "require": {
        "types": "./dist/edge.d.cts",
        "default": "./dist/edge.cjs"
      },
      "default": "./dist/edge.mjs"
    },
    "./proof": {
      "import": {
        "types": "./dist/proof.d.mts",
        "default": "./dist/proof.mjs"
      },
      "require": {
        "types": "./dist/proof.d.cts",
        "default": "./dist/proof.cjs"
      },
      "default": "./dist/proof.mjs"
    },
    "./recipient": {
      "import": {
        "types": "./dist/recipient.d.mts",
        "default": "./dist/recipient.mjs"
      },
      "require": {
        "types": "./dist/recipient.d.cts",
        "default": "./dist/recipient.cjs"
      },
      "default": "./dist/recipient.mjs"
    },
    "./secret": {
      "import": {
        "types": "./dist/secret.d.mts",
        "default": "./dist/secret.mjs"
      },
      "require": {
        "types": "./dist/secret.d.cts",
        "default": "./dist/secret.cjs"
      },
      "default": "./dist/secret.mjs"
    },
    "./signature": {
      "import": {
        "types": "./dist/signature.d.mts",
        "default": "./dist/signature.mjs"
      },
      "require": {
        "types": "./dist/signature.d.cts",
        "default": "./dist/signature.cjs"
      },
      "default": "./dist/signature.mjs"
    },
    "./sskr": {
      "import": {
        "types": "./dist/sskr.d.mts",
        "default": "./dist/sskr.mjs"
      },
      "require": {
        "types": "./dist/sskr.d.cts",
        "default": "./dist/sskr.cjs"
      },
      "default": "./dist/sskr.mjs"
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      },
      "default": "./dist/types.mjs"
    },
    "./seal": {
      "import": {
        "types": "./dist/seal.d.mts",
        "default": "./dist/seal.mjs"
      },
      "require": {
        "types": "./dist/seal.d.cts",
        "default": "./dist/seal.cjs"
      },
      "default": "./dist/seal.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown && bun scripts/fix-all-augmentation.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "size": "size-limit",
    "api:snapshot": "bun scripts/api-snapshot.ts && bun scripts/api-report.ts --local",
    "api:check": "bun scripts/api-snapshot.ts --check && bun scripts/api-report.ts",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "postinstall": "bun scripts/pin-lint-typescript.ts",
    "prepublishOnly": "npm run build",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "check:deps": "bun scripts/check-deps.ts",
    "test:golden": "vitest run tests/golden-vectors.test.ts",
    "test:differential": "vitest run tests/differential.test.ts",
    "vectors:generate": "bun scripts/generate-vectors.ts",
    "vectors:full": "bun scripts/generate-vectors.ts --full tests/rust-validation/target/corpus.json",
    "baseline:build": "bun scripts/build-baseline.ts"
  },
  "keywords": [
    "envelope",
    "cbor",
    "dcbor",
    "gordian",
    "blockchain-commons",
    "privacy",
    "encryption",
    "deterministic",
    "encoding",
    "serialization"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@blockchaincommons/components": "^1.0.0-beta.3",
    "@blockchaincommons/crypto": "^1.0.0-beta.3",
    "@blockchaincommons/dcbor": "^1.0.0-beta.3",
    "@blockchaincommons/known-values": "^1.0.0-beta.3",
    "@blockchaincommons/rand": "^1.0.0-beta.3",
    "@blockchaincommons/sskr": "^1.0.0-beta.3",
    "@blockchaincommons/tags": "^1.0.0-beta.3",
    "@blockchaincommons/uniform-resources": "^1.0.0-beta.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "pako": "^3.0.2",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "size-limit": "^13.1.1",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.0.0"
  }
}
