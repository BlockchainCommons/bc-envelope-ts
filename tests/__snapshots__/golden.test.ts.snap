exports[`golden: behaviour snapshots > the reference's error variant at every operation 1`] = `
[
  "encrypt twice: throw:EnvelopeError:AlreadyEncrypted:envelope was already encrypted or compressed, so it cannot be encrypte",
  "encrypt elided: throw:EnvelopeError:AlreadyElided:envelope was elided, so it cannot be compressed or encrypted",
  "decrypt plain: throw:EnvelopeError:NotEncrypted:cannot decrypt an envelope that was not encrypted",
  "wrong key: throw:EnvelopeError:Components:components error: cryptographic operation failed: AEAD error <- ComponentsError:Crypto:cryptographic operation failed: AEAD error <- CryptoError:AuthenticationFailed:AEAD error <- Error:invalid tag",
  "compress encrypted: throw:EnvelopeError:AlreadyEncrypted:envelope was already encrypted or compressed, so it cannot be encrypte",
  "decompress plain: throw:EnvelopeError:NotCompressed:cannot decompress an envelope that was not compressed",
  "decryptSubjectToRecipient non-recipient: throw:EnvelopeError:UnknownRecipient:unknown recipient",
  "decryptSubjectToRecipient no recipients: throw:EnvelopeError:UnknownRecipient:unknown recipient",
  "attachmentPayload on non-attachment: throw:EnvelopeError:InvalidAttachment:invalid attachment",
  "expectAttachment none: throw:EnvelopeError:NonexistentAttachment:nonexistent attachment",
  "Request.fromEnvelope mismatch: throw:EnvelopeError:Cbor:dcbor error: Expected function Named(Dynamic("g")), but found Named(Dy <- CborError:Custom:Expected function Named(Dynamic("g")), but found Named(Dynamic("f"))",
]
`;

