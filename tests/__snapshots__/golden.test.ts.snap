                bd52917f obj "Person"
            78d666eb ASSERTION
                db7dd21c pred "knows"
                13b74194 obj "Bob"
    75841db6 ASSERTION
        d0e39e78 pred 'signed'
        d88b3142 obj Signature(SshEd25519)
